# Shared publication style: readable at IEEE single-column width (~3.5 in).
# Colour choices are colour-blind-conscious (Okabe-Ito palette); retain distinct markers/linestyles too.
figure.figsize: 3.5, 2.5
figure.dpi: 150
savefig.dpi: 300
savefig.format: pdf
savefig.bbox: tight
font.family: sans-serif
font.size: 8
axes.titlesize: 8
axes.labelsize: 8
axes.linewidth: 0.7
axes.spines.top: False
axes.spines.right: False
axes.prop_cycle: cycler('color', ['0072B2', 'D55E00', '009E73', 'E69F00', '56B4E9', 'CC79A7', 'F0E442', '000000'])
lines.linewidth: 1.4
lines.markersize: 3
legend.fontsize: 7
legend.frameon: False
xtick.labelsize: 7
xtick.major.width: 0.7
ytick.labelsize: 7
ytick.major.width: 0.7
pdf.fonttype: 42
ps.fonttype: 42
axes.grid: True
axes.axisbelow: True
grid.alpha: 0.25
grid.linewidth: 0.5
errorbar.capsize: 2
